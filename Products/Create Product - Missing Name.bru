meta {
  name: Create Product - Missing Name
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/products
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "price": 19.99,
    "category": "electronics"
  }
}

tests {
  test("status code is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("response has error property", function() {
    const body = res.getBody();
    expect(body).to.have.property("error");
  });

  test("error mentions required fields", function() {
    const body = res.getBody();
    expect(body.error).to.equal("name and price are required");
  });

  test("no id is returned in error response", function() {
    const body = res.getBody();
    expect(body).to.not.have.property("id");
  });
}
