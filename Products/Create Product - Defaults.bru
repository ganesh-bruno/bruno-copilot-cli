meta {
  name: Create Product - Defaults
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/products
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Basic Widget",
    "price": 5.49
  }
}

tests {
  test("status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("category defaults to 'general' when not provided", function() {
    const body = res.getBody();
    expect(body.category).to.equal("general");
  });

  test("stock defaults to 0 when not provided", function() {
    const body = res.getBody();
    expect(body.stock).to.equal(0);
  });

  test("name matches sent value", function() {
    const body = res.getBody();
    expect(body.name).to.equal("Basic Widget");
  });

  test("price matches sent value", function() {
    const body = res.getBody();
    expect(body.price).to.equal(5.49);
  });

  test("id is auto-generated", function() {
    const body = res.getBody();
    expect(typeof body.id).to.equal("number");
  });
}
