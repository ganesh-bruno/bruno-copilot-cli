meta {
  name: Create Product - Missing Price
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/products
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "No Price Item",
    "category": "stationery"
  }
}

tests {
  test("status code is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("response has error property", function() {
    const body = res.getBody();
    expect(body).to.have.property("error");
  });

  test("error mentions required fields", function() {
    const body = res.getBody();
    expect(body.error).to.equal("name and price are required");
  });
}
