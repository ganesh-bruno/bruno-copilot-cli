meta {
  name: Get All Products
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/products
  body: none
  auth: none
}

tests {
  test("status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("response is an array", function() {
    const body = res.getBody();
    expect(Array.isArray(body)).to.be.true;
  });

  test("array is not empty", function() {
    const body = res.getBody();
    expect(body.length).to.be.greaterThan(0);
  });

  test("every product has id, name, price, category, stock", function() {
    const body = res.getBody();
    body.forEach(product => {
      expect(product).to.have.property("id");
      expect(product).to.have.property("name");
      expect(product).to.have.property("price");
      expect(product).to.have.property("category");
      expect(product).to.have.property("stock");
    });
  });

  test("id is a number for every product", function() {
    const body = res.getBody();
    body.forEach(product => {
      expect(typeof product.id).to.equal("number");
    });
  });

  test("price is a positive number for every product", function() {
    const body = res.getBody();
    body.forEach(product => {
      expect(typeof product.price).to.equal("number");
      expect(product.price).to.be.greaterThan(0);
    });
  });

  test("stock is a non-negative number for every product", function() {
    const body = res.getBody();
    body.forEach(product => {
      expect(typeof product.stock).to.equal("number");
      expect(product.stock).to.be.at.least(0);
    });
  });

  test("name is a non-empty string for every product", function() {
    const body = res.getBody();
    body.forEach(product => {
      expect(typeof product.name).to.equal("string");
      expect(product.name.length).to.be.greaterThan(0);
    });
  });

  test("category is a non-empty string for every product", function() {
    const body = res.getBody();
    body.forEach(product => {
      expect(typeof product.category).to.equal("string");
      expect(product.category.length).to.be.greaterThan(0);
    });
  });

  test("content-type is application/json", function() {
    expect(res.getHeader("content-type")).to.include("application/json");
  });
}
